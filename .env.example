# ---------------------------------------------------------------------------
# Supabase (required)
# ---------------------------------------------------------------------------
# From your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS — used for audit writes and seeding.
# Never expose this to the browser and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# On-chain identifier salt (required)
# ---------------------------------------------------------------------------
# Any long random string. Pseudonymous on-chain refs are derived from
# sha256(salt + uuid), so this salt is what stops on-chain identifiers from
# being correlated back to real users. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHAIN_REF_SALT=generate-a-long-random-string

# ---------------------------------------------------------------------------
# Blockchain (optional — the app runs fully without these)
# ---------------------------------------------------------------------------
# When unset, permissions and records still work; blockchain status is
# reported honestly as "unavailable" rather than faked as confirmed.
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your-project-id
BLOCKCHAIN_SIGNER_PRIVATE_KEY=0xyour-funded-sepolia-test-account-private-key
MEDICAL_MEMORY_CONTRACT_ADDRESS=0xdeployed-contract-address

# ---------------------------------------------------------------------------
# AI (optional — the app runs fully without this)
# ---------------------------------------------------------------------------
# When unset, the Clinical History Brief reports "Clinical summary
# unavailable" and every other feature continues working.
ANTHROPIC_API_KEY=your-anthropic-api-key
